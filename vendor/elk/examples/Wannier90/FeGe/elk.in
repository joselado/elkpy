
! Wannierisation of FeGe in the cubic phase.

! Thanks to Wenhan Chen and Sebastian Kalhoefer for the example.

tasks
  0
  20
  550

wrtdisk
 .false.

! band structure vertices
plot1d
  6 500                 : nvp1d, npp1d
  0.25  0.75  0.5       : vlvp1d
  0.5   0.5   0.5
  0.0   0.0   0.0
  0.0   0.5   0.5
  0.25  0.75  0.5
  0.375 0.75  0.375

! calculate the projectors for each spin, l and atom
projw90
 .true.

! list of species and angular momenta
lprojw90
  1 0 1 2 : species, l values
  2 0 1 2

! select the band indices for wannierisation to avoid the semicore states
idxw90
  73-300

num_iter
  1000

dis_num_iter
  2000

xlwin
bands_plot = true
kpath = true
kpath_task = bands
kpath_num_points = 500
begin kpoint_path
   W  0.25  0.75  0.5        L  0.5   0.5   0.5
   L  0.5   0.5   0.5        G  0.0   0.0   0.0
   G  0.0   0.0   0.0        X  0.0   0.5   0.5
   X  0.0   0.5   0.5        W  0.25  0.75  0.5
   W  0.25  0.75  0.5        K  0.375 0.75  0.375
end kpoint_path
write_hr = true
dis_win_min = -16.0
dis_win_max = 80.0
dis_froz_min = -15.8
dis_froz_max = 4.0

spinorb
 .true.

bfieldc
  0.01 0.0 0.01

highq
 .true.

lradstp
  1

nrmtscf
  1

lorbcnd
 .false.

nxoapwlo
  1

epspot
  1.e-8

epsengy
  1.e-8

ngridk
  8 8 8

! large number of empty states required
nempty
  64

! https://journals.aps.org/prb/abstract/10.1103/PhysRevB.100.214406 table1

! Atomic positions generated by spacegroup version 1.2.01
!  Hermann-Mauguin symbol : P213
!  Hall symbol            : P 2ac 2ab 3
!  Schoenflies symbol     : T^4
!  space group number     : 198
!  lattice constants (a,b,c) :    8.862815526       8.862815526       8.862815526    
!  angles in degrees (bc,ac,ab) :    90.00000000       90.00000000       90.00000000    
!  number of conventional unit cells :    1   1   1
!  reduction to primitive cell : T
!  Wyckoff positions :
!   species :    1, Fe
!     0.1350000000      0.1350000000      0.1350000000    
!   species :    2, Ge
!     0.8420000000      0.8420000000      0.8420000000    

avec
   8.862815526       0.000000000       0.000000000    
   0.000000000       8.862815526       0.000000000    
   0.000000000       0.000000000       8.862815526    

sppath
  '../../../species/'

atoms
   2                                    : nspecies
'Fe.in'                                 : spfname
   4                                    : natoms; atposl, bfcmt below
    0.13500000    0.13500000    0.13500000    0.00000000  0.00000000  0.00000000
    0.36500000    0.86500000    0.63500000    0.00000000  0.00000000  0.00000000
    0.63500000    0.36500000    0.86500000    0.00000000  0.00000000  0.00000000
    0.86500000    0.63500000    0.36500000    0.00000000  0.00000000  0.00000000
'Ge.in'                                 : spfname
   4                                    : natoms; atposl, bfcmt below
    0.84200000    0.84200000    0.84200000    0.00000000  0.00000000  0.00000000
    0.65800000    0.15800000    0.34200000    0.00000000  0.00000000  0.00000000
    0.34200000    0.65800000    0.15800000    0.00000000  0.00000000  0.00000000
    0.15800000    0.34200000    0.65800000    0.00000000  0.00000000  0.00000000

