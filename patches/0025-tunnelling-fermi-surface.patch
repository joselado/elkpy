diff --git a/src/elkpy_fermitunnel.f90 b/src/elkpy_fermitunnel.f90
new file mode 100644
--- /dev/null
+++ b/src/elkpy_fermitunnel.f90
@@ -0,0 +1,483 @@
+
+! elkpy extension (not upstream Elk): the momentum-resolved tunnelling Fermi
+! surface -- the Fermi surface weighted by the nonlocal Green's function
+! between an infinite PLANAR tip above a two-dimensional material and an
+! infinite substrate plane below it.
+! This file is distributed under the terms of the GNU General Public License.
+
+!BOP
+! !ROUTINE: elkpy_fermitunnel
+! !INTERFACE:
+subroutine elkpy_fermitunnel
+! !USES:
+use modmain
+! !DESCRIPTION:
+!   Exports, on a uniform $k$-grid, the two plane Gram matrices that turn the
+!   Fermi surface into what a {\it planar} tunnel junction actually samples.
+!
+!   The vertical transport task (9005, {\tt elkpy\_transport.f90}) takes a
+!   {\it point} tip at ${\bf r}$ and gives the map
+!   $T({\bf r};E)=\int_{\rm exit}|G({\bf r},{\bf r}';E)|^2 d^2r'$. Replace the
+!   point tip by an infinite plane at height $z_{\rm t}$ and the same
+!   Landauer-B\"uttiker trace becomes a double plane integral,
+!   $$ T(E)=\int_{\rm tip}d^2r\int_{\rm exit}d^2r'\,|G({\bf r},{\bf r}';E)|^2. $$
+!   Both planes are invariant under every lateral lattice translation, so the
+!   lateral momentum is conserved on the way in {\it and} on the way out, the
+!   $k$-sum is incoherent, and what is left is one number per $k$-point,
+!   $$ T(E)=\sum_{\bf k}w_{\bf k}W({\bf k};E),\qquad
+!    W({\bf k};E)={\rm Tr}\big[D\,G^{\rm t}_{\bf k}\,D\,S_{\bf k}\big], $$
+!   with $D={\rm diag}(g_n)$ the on-shell amplitudes
+!   $g_n=\sqrt{{\rm occmax}\,\delta_\eta(E-\varepsilon_{n{\bf k}})/\eta}$ and
+!   $$ G^{\rm t}_{\bf k}[n,m]=\int_{\rm tip}\psi^*_{n{\bf k}}\hat Q_{\rm t}
+!    \psi_{m{\bf k}}\,d^2r,\qquad
+!    S_{\bf k}[n,m]=\int_{\rm exit}\psi^*_{n{\bf k}}\hat P_{\rm s}
+!    \psi_{m{\bf k}}\,d^2r' $$
+!   the bands' Gram matrices restricted to the tip and exit planes, with
+!   $\hat Q_{\rm t}$, $\hat P_{\rm s}$ the tip's and substrate's spin
+!   acceptance. This routine writes the eigenvalues, $G^{\rm t}_{\bf k}$ and
+!   $S_{\bf k}$; the on-shell weight, the contraction, the coherent/incoherent
+!   split and every diagnostic are done on the elkpy (Python) side --
+!   {\tt elkpy.parsers.fermitunnel}.
+!
+!   Two limits are then free on the Python side and are what make the result
+!   readable: $G^{\rm t}=S=1$ gives $W=\sum_n\delta(E-\varepsilon_{n{\bf k}})$,
+!   the plain Fermi surface; $S=1$ alone gives
+!   $W=\sum_n\delta(E-\varepsilon_{n{\bf k}})G^{\rm t}[n,n]$, the Fermi surface
+!   weighted by how much of each state survives out at the tip plane -- a
+!   planar Tersoff-Hamann image in momentum space.
+!
+!   The exact relation to task 9005 is the plane integral of its own map,
+!   $\int_{\rm tip\ cell}T({\bf r};E)\,d^2r=\sum_{\bf k}w_{\bf k}W({\bf k};E)$,
+!   which is how this is tested rather than merely argued.
+!
+!   Both planes must lie in the {\it interstitial} region and the material
+!   must lie between them; both are checked here, since inside a muffin-tin
+!   sphere the interstitial plane-wave sum is not the wavefunction and the
+!   formula below would return a perfectly plausible number. The Gram matrices
+!   themselves involve no quadrature at all: in the interstitial
+!   $\psi({\bf r})=\Omega^{-1/2}\sum_{\bf G}c_{\bf G}
+!   e^{i({\bf k}+{\bf G})\cdot{\bf r}}$, so a plane spanned by two lattice
+!   vectors turns the integral into an orthogonality relation between the
+!   in-plane $G$-vector indices -- see {\tt elkpy\_plane\_gram}.
+!
+!   The $k$-points are generated here as a uniform grid
+!   ({\tt elkpy\_fermitunnel\_kgrid}, with an optional offset) and each is
+!   diagonalised fresh by {\tt elkpy\_transport\_wf}
+!   ({\tt elkpy\_transport.f90}), so the mesh is independent of the ground
+!   state's own {\tt ngridk} and of {\tt reducek} -- which is what a Fermi
+!   surface needs, since a reduced mesh does not cover the Brillouin zone.
+!
+! !REVISION HISTORY:
+!   Created 2026 (elkpy)
+!EOP
+!BOC
+implicit none
+! local variables
+integer iax,jax,kax,i1,i2,i3,ik,nkpt_t
+integer ist,jst,nsel,ispn,ias,is,ia,m
+real(8) area,wkpt_t,t1,t2,e0,e1,tpol,spol,ta
+real(8) vn(3),vc1(3),vc2(3),vc3(3),va(3),tdir(3),sdir(3)
+real(8) vklt(3),vkct(3),dmin,d,smin,smax
+complex(8) projt(2,2),projs(2,2)
+character(256) fname
+! allocatable arrays. As in elkpy_transport.f90 these are deliberately NOT
+! automatic arrays: nstsv/ngkmax/nspnfv are only set by the init0/init1 calls
+! below, so with task 9007 run on its own they would all have size zero
+integer, allocatable :: ngp(:),igpig(:,:),isel(:)
+real(8), allocatable :: evalt(:)
+complex(8), allocatable :: wfgp(:,:,:),cpk(:,:,:),gtip(:,:),sexit(:,:)
+if (spinsprl) then
+  write(*,*)
+  write(*,'("Error(elkpy_fermitunnel): spin-spirals not supported")')
+  write(*,*)
+  stop
+end if
+iax=elkpy_ft_axis
+if ((iax < 1).or.(iax > 3)) then
+  write(*,*)
+  write(*,'("Error(elkpy_fermitunnel): plane axis must be 1, 2 or 3 : ",I8)') &
+   iax
+  write(*,*)
+  stop
+end if
+do i1=1,3
+  if (elkpy_ft_ngrid(i1) < 1) then
+    write(*,*)
+    write(*,'("Error(elkpy_fermitunnel): elkpy_fermitunnel_kgrid must be &
+     &positive : ",3I8)') elkpy_ft_ngrid
+    write(*,*)
+    stop
+  end if
+end do
+if (elkpy_ft_window(2) <= elkpy_ft_window(1)) then
+  write(*,*)
+  write(*,'("Error(elkpy_fermitunnel): empty energy window : ",2G18.10)') &
+   elkpy_ft_window
+  write(*,*)
+  stop
+end if
+! initialise universal variables (the same sequence bandstr.f90 and
+! elkpy_transport.f90 use, since this task also diagonalises fresh at
+! arbitrary k-points); readstate also restores efermi from STATE.OUT
+call init0
+call init1
+call readstate
+call genvsig
+call linengy
+call genapwlofr
+call gensocfr
+allocate(ngp(nspnfv),igpig(ngkmax,nspnfv),isel(nstsv),evalt(nstsv))
+tpol=elkpy_ft_tpol
+spol=elkpy_ft_spol
+! the two lattice vectors spanning both planes, and the one they are offset
+! along
+jax=mod(iax,3)+1
+kax=mod(iax+1,3)+1
+vc1(:)=avec(:,jax)
+vc2(:)=avec(:,kax)
+va(:)=avec(:,iax)
+call r3cross(vc1,vc2,vc3)
+area=sqrt(vc3(1)**2+vc3(2)**2+vc3(3)**2)
+vn(:)=vc3(:)/area
+! a polarised tip or substrate needs a spinor wavefunction for the projector
+! to act on; without one the code below would silently scale the whole Gram
+! matrix by 1+P*n_z instead, which is a plausible number and not a spin
+! selection at all
+if (((abs(tpol) > 1.d-8).or.(abs(spol) > 1.d-8)).and.(.not.spinpol)) then
+  write(*,*)
+  write(*,'("Error(elkpy_fermitunnel): a non-zero tip or substrate &
+   &polarisation requires")')
+  write(*,'(" a spin-polarised calculation (set spinpol and/or spinorb): &
+   &without one there")')
+  write(*,'("  is no spin index for the projector 1 + P n.sigma to act on")')
+  write(*,*)
+  stop
+end if
+call elkpy_ft_proj(elkpy_ft_tdir,tpol,tdir,projt)
+call elkpy_ft_proj(elkpy_ft_sdir,spol,sdir,projs)
+!--------------------------------------------------------------------!
+!     both planes in the interstitial, material between them         !
+!--------------------------------------------------------------------!
+! every atom's perpendicular distance to each plane, including the plane's
+! own periodic images along the offset axis. Lateral images all lie IN the
+! plane, so they need no loop -- that is the whole point of a plane spanned
+! by two lattice vectors
+ta=va(1)*vn(1)+va(2)*vn(2)+va(3)*vn(3)
+do i1=1,2
+  if (i1 == 1) then
+    t2=elkpy_ft_tip
+  else
+    t2=elkpy_ft_exit
+  end if
+  dmin=1.d8
+  do ias=1,natmtot
+    is=idxis(ias)
+    ia=idxia(ias)
+    d=atposc(1,ia,is)*vn(1)+atposc(2,ia,is)*vn(2)+atposc(3,ia,is)*vn(3) &
+     -t2*ta
+    do m=-2,2
+      dmin=min(dmin,abs(d+dble(m)*ta)-rmt(is))
+    end do
+  end do
+  if (dmin <= 0.d0) then
+    write(*,*)
+    if (i1 == 1) then
+      write(*,'("Error(elkpy_fermitunnel): the TIP plane cuts a muffin-tin &
+       &sphere")')
+    else
+      write(*,'("Error(elkpy_fermitunnel): the EXIT plane cuts a muffin-tin &
+       &sphere")')
+    end if
+    write(*,'(" closest approach minus muffin-tin radius : ",G18.10)') dmin
+    write(*,'(" the plane Gram matrices are built from the interstitial &
+     &plane-wave")')
+    write(*,'("  representation alone, which is not the wavefunction inside &
+     &a sphere.")')
+    write(*,'("  Move the plane into the vacuum")')
+    write(*,*)
+    stop
+  end if
+end do
+! the material has to lie BETWEEN the two planes: a cell is periodic, so
+! "above" and "below" are only meaningful relative to where the atoms are.
+! Measured as fractional coordinates along the plane axis, taken relative to
+! the exit plane and wrapped into [0,1)
+smin=1.d8
+smax=-1.d8
+do ias=1,natmtot
+  is=idxis(ias)
+  ia=idxia(ias)
+  t1=atposl(iax,ia,is)-elkpy_ft_exit
+  t1=t1-dble(floor(t1))
+  smin=min(smin,t1)
+  smax=max(smax,t1)
+end do
+t1=elkpy_ft_tip-elkpy_ft_exit
+t1=t1-dble(floor(t1))
+! two coincident planes is the deliberate self-check configuration: the two
+! Gram matrices are then the SAME integral, so the tunnelling weight collapses
+! to Tr[D G D G] and can be checked against a literal quadrature. It is not a
+! transport geometry, so the between-the-planes test does not apply to it
+if (t1 < epslat) then
+  write(*,*)
+  write(*,'("Info(elkpy_fermitunnel): the tip plane coincides with the exit &
+   &plane.")')
+  write(*,'(" This is the self-check configuration, not a junction geometry")')
+else if (t1 < smax) then
+  write(*,*)
+  write(*,'("Error(elkpy_fermitunnel): the material does not lie between the &
+   &two planes")')
+  write(*,'(" atoms span [",G18.10,",",G18.10,"], tip plane at ",G18.10)') &
+   smin,smax,t1
+  write(*,'("  (fractional coordinates along axis ",I1,", relative to the &
+   &exit plane;")') iax
+  write(*,'("  the tip plane must come AFTER the atoms, not before them).")')
+  write(*,'("  What this computes would then not be a current through the &
+   &material.")')
+  if (tshift) then
+    write(*,'("  NOTE tshift is .true., so Elk has relocated the origin (for &
+     &a crystal")')
+    write(*,'("  with inversion, onto the inversion centre) while both planes &
+     &are still")')
+    write(*,'("  in YOUR frame. Set tshift .false. to keep the two frames &
+     &the same --")')
+    write(*,'("  the usual cause of this message")')
+  end if
+  write(*,*)
+  stop
+end if
+if (tshift) then
+  write(*,*)
+  write(*,'("Info(elkpy_fermitunnel): tshift is .true., so the atomic basis &
+   &Elk uses")')
+  write(*,'(" is not necessarily the one in elk.in, while both planes are &
+   &taken in the")')
+  write(*,'(" input frame. Along axis ",I1," the atoms sit at fractional &
+   &coordinates")') iax
+  write(*,'(" ",G18.10," to ",G18.10," relative to the exit plane.")') &
+   smin,smax
+  write(*,'(" Set tshift .false. to keep the two frames identical")')
+end if
+!--------------------------!
+!     the k-point loop     !
+!--------------------------!
+nkpt_t=elkpy_ft_ngrid(1)*elkpy_ft_ngrid(2)*elkpy_ft_ngrid(3)
+wkpt_t=1.d0/dble(nkpt_t)
+e0=efermi+elkpy_ft_window(1)
+e1=efermi+elkpy_ft_window(2)
+allocate(wfgp(ngkmax,nspinor,nstsv))
+fname='ELKPY_FERMITUNNEL.OUT'
+open(50,file=trim(fname),action='WRITE',form='FORMATTED')
+write(50,'("elkpy tunnelling Fermi surface: tip- and exit-plane Gram &
+ &matrices")')
+write(50,'(6I8," : nkpt nspinor kgrid(1:3) plane-axis")') nkpt_t,nspinor, &
+ elkpy_ft_ngrid(1),elkpy_ft_ngrid(2),elkpy_ft_ngrid(3),iax
+write(50,'(5G24.15," : efermi tip-height exit-height area omega")') efermi, &
+ elkpy_ft_tip,elkpy_ft_exit,area,omega
+write(50,'(3G24.15," : koffset(1:3)")') elkpy_ft_koff(1),elkpy_ft_koff(2), &
+ elkpy_ft_koff(3)
+write(50,'(2G24.15," : window(1) window(2), relative to efermi")') &
+ elkpy_ft_window(1),elkpy_ft_window(2)
+write(50,'(8G24.15," : tip pol, tip dir(1:3), substrate pol, dir(1:3)")') &
+ tpol,tdir(1),tdir(2),tdir(3),spol,sdir(1),sdir(2),sdir(3)
+do ik=1,nkpt_t
+  i3=(ik-1)/(elkpy_ft_ngrid(1)*elkpy_ft_ngrid(2))
+  i2=mod((ik-1)/elkpy_ft_ngrid(1),elkpy_ft_ngrid(2))
+  i1=mod(ik-1,elkpy_ft_ngrid(1))
+  vklt(1)=(dble(i1)+elkpy_ft_koff(1))/dble(elkpy_ft_ngrid(1))
+  vklt(2)=(dble(i2)+elkpy_ft_koff(2))/dble(elkpy_ft_ngrid(2))
+  vklt(3)=(dble(i3)+elkpy_ft_koff(3))/dble(elkpy_ft_ngrid(3))
+  vkct(1:3)=bvec(1:3,1)*vklt(1)+bvec(1:3,2)*vklt(2)+bvec(1:3,3)*vklt(3)
+! fresh diagonalisation, plus the interstitial G+p-space coefficients (the
+! same routine task 9005 uses -- elkpy_transport.f90)
+  call elkpy_transport_wf(vklt,evalt,wfgp,ngp,igpig)
+! select the states inside the energy window
+  nsel=0
+  do ist=1,nstsv
+    if ((evalt(ist) >= e0).and.(evalt(ist) <= e1)) then
+      nsel=nsel+1
+      isel(nsel)=ist
+    end if
+  end do
+  write(50,'(7G24.15,I8," : k (lattice), k (Cartesian), weight, states")') &
+   vklt(1),vklt(2),vklt(3),vkct(1),vkct(2),vkct(3),wkpt_t,nsel
+  do ist=1,nsel
+    write(50,'(I8,G24.15)') isel(ist),evalt(isel(ist))
+  end do
+  if (nsel == 0) cycle
+! repack the selected states' coefficients contiguously
+  allocate(cpk(ngp(1),nsel,nspinor))
+  do ispn=1,nspinor
+    do ist=1,nsel
+      cpk(1:ngp(1),ist,ispn)=wfgp(1:ngp(1),ispn,isel(ist))
+    end do
+  end do
+  allocate(gtip(nsel,nsel),sexit(nsel,nsel))
+  call elkpy_plane_gram(iax,elkpy_ft_tip,ngp(1),igpig(:,1),nsel,cpk,projt, &
+   area,gtip)
+  call elkpy_plane_gram(iax,elkpy_ft_exit,ngp(1),igpig(:,1),nsel,cpk,projs, &
+   area,sexit)
+  do jst=1,nsel
+    do ist=1,nsel
+      write(50,'(2G24.15)') dble(gtip(ist,jst)),aimag(gtip(ist,jst))
+    end do
+  end do
+  do jst=1,nsel
+    do ist=1,nsel
+      write(50,'(2G24.15)') dble(sexit(ist,jst)),aimag(sexit(ist,jst))
+    end do
+  end do
+  deallocate(cpk,gtip,sexit)
+end do
+close(50)
+deallocate(wfgp,ngp,igpig,isel,evalt)
+write(*,*)
+write(*,'("Info(elkpy_fermitunnel):")')
+write(*,'(" tip- and exit-plane Gram matrices written to ",A)') trim(fname)
+write(*,'(" k-grid : ",3I6," (",I0," points, generated here and diagonalised &
+ &fresh)")') elkpy_ft_ngrid,nkpt_t
+write(*,'(" plane axis ",I1,", tip at ",G18.10,", exit at ",G18.10)') iax, &
+ elkpy_ft_tip,elkpy_ft_exit
+write(*,'(" energy window relative to efermi : ",2G18.10)') elkpy_ft_window
+write(*,'(" tip polarisation ",G18.10," along ",3G18.10)') tpol,tdir
+write(*,'(" substrate polarisation ",G18.10," along ",3G18.10)') spol,sdir
+end subroutine
+!EOC
+
+!BOP
+! !ROUTINE: elkpy_ft_proj
+! !INTERFACE:
+subroutine elkpy_ft_proj(vin,pol,vout,proj)
+! !USES:
+use modmain
+! !DESCRIPTION:
+!   Builds a lead's spin acceptance $\hat P=1+P\,\hat{\bf n}\cdot
+!   \boldsymbol\sigma$ as a $2\times2$ matrix in spin space, and returns the
+!   normalised direction $\hat{\bf n}$. Unlike a tip polarisation applied to a
+!   density ({\tt elkpy\_stm.f90}), this sits {\it inside} an overlap integral,
+!   between two different bands -- a density has already been squared. The
+!   normalisation is {\tt elkpy\_stm.f90}'s own rather than the
+!   $(1+P\hat{\bf n}\cdot\boldsymbol\sigma)/2$ a Landauer coupling matrix is
+!   usually written with, so that $P=0$ gives the plain spin-summed Gram
+!   matrix with no factor; the overall lead coupling is an unfixed prefactor
+!   in any case.
+!
+! !REVISION HISTORY:
+!   Created 2026 (elkpy)
+!EOP
+!BOC
+implicit none
+! arguments
+real(8), intent(in) :: vin(3),pol
+real(8), intent(out) :: vout(3)
+complex(8), intent(out) :: proj(2,2)
+! local variables
+real(8) t1
+t1=sqrt(vin(1)**2+vin(2)**2+vin(3)**2)
+if (t1 > 1.d-8) then
+  vout(:)=vin(:)/t1
+else
+  vout(:)=[0.d0,0.d0,1.d0]
+end if
+proj(1,1)=cmplx(1.d0+pol*vout(3),0.d0,8)
+proj(2,2)=cmplx(1.d0-pol*vout(3),0.d0,8)
+proj(1,2)=cmplx(pol*vout(1),-pol*vout(2),8)
+proj(2,1)=cmplx(pol*vout(1),pol*vout(2),8)
+end subroutine
+!EOC
+
+!BOP
+! !ROUTINE: elkpy_plane_gram
+! !INTERFACE:
+subroutine elkpy_plane_gram(iax,hgt,ngp,igpig,nsel,cpk,proj,area,smat)
+! !USES:
+use modmain
+! !DESCRIPTION:
+!   The bands' Gram matrix restricted to one lattice plane,
+!   $$ S[n,m]=\int_{\rm plane\ in\ one\ cell}\psi^*_{n{\bf k}}({\bf r})\,
+!    \hat P\,\psi_{m{\bf k}}({\bf r})\,d^2r, $$
+!   evaluated in closed form. In the interstitial
+!   $\psi=\Omega^{-1/2}\sum_{\bf G}c_{\bf G}e^{i({\bf k}+{\bf G})\cdot{\bf r}}$,
+!   and on a plane spanned by two lattice vectors ${\bf a}_j,{\bf a}_k$ at
+!   fractional coordinate $s$ along the third the ${\bf k}$-dependent phases
+!   cancel between the two wavefunctions and the in-plane integral is an
+!   orthogonality relation between the in-plane $G$-vector indices:
+!   $$ S[n,m]=\frac{A}{\Omega}\sum_{{\bf G}_\parallel}
+!    b^*_n({\bf G}_\parallel)\,\hat P\,b_m({\bf G}_\parallel),\qquad
+!    b_n({\bf G}_\parallel)=\sum_{G_3}c_n({\bf G}_\parallel,G_3)
+!    e^{2\pi iG_3s}, $$
+!   with $A=|{\bf a}_j\times{\bf a}_k|$ the surface cell area. Nothing is
+!   sampled and nothing converges. A plane not spanned by two lattice vectors
+!   has no such relation, which is why every plane in this family is specified
+!   as an axis plus a height rather than as a general parallelogram.
+!
+!   This is the same collapse {\tt elkpy\_transport.f90} performs inline for
+!   its exit plane; it is repeated here rather than shared so that the
+!   already-verified task 9005 is not edited. {\tt tests/} pins the two
+!   against each other on a real run, so the duplicate cannot drift.
+!
+!   The plane must lie in the interstitial -- inside a muffin-tin sphere the
+!   plane-wave sum is not the wavefunction and this returns a plausible
+!   number. The caller checks it.
+!
+! !REVISION HISTORY:
+!   Created 2026 (elkpy)
+!EOP
+!BOC
+implicit none
+! arguments
+integer, intent(in) :: iax,ngp,igpig(ngp),nsel
+real(8), intent(in) :: hgt,area
+complex(8), intent(in) :: cpk(ngp,nsel,nspinor),proj(2,2)
+complex(8), intent(out) :: smat(nsel,nsel)
+! local variables
+integer jax,kax,igp,ig,h1,h2,h3,iu,nu,ispn,jspn
+real(8) t1
+complex(8) z1
+! allocatable arrays
+integer, allocatable :: imap(:,:),igrp(:)
+complex(8), allocatable :: b(:,:,:),tmp(:,:)
+jax=mod(iax,3)+1
+kax=mod(iax+1,3)+1
+allocate(imap(intgv(1,jax):intgv(2,jax),intgv(1,kax):intgv(2,kax)))
+allocate(igrp(ngp))
+! collapse the G-sphere onto its shadow on the surface reciprocal lattice
+imap(:,:)=0
+nu=0
+do igp=1,ngp
+  ig=igpig(igp)
+  h1=ivg(jax,ig)
+  h2=ivg(kax,ig)
+  if (imap(h1,h2) == 0) then
+    nu=nu+1
+    imap(h1,h2)=nu
+  end if
+  igrp(igp)=imap(h1,h2)
+end do
+allocate(b(nu,nsel,nspinor))
+b(:,:,:)=0.d0
+! carrying the plane's height in the phase of the summed-over component
+do igp=1,ngp
+  ig=igpig(igp)
+  h3=ivg(iax,ig)
+  t1=twopi*dble(h3)*hgt
+  z1=cmplx(cos(t1),sin(t1),8)
+  iu=igrp(igp)
+  do ispn=1,nspinor
+    b(iu,1:nsel,ispn)=b(iu,1:nsel,ispn)+z1*cpk(igp,1:nsel,ispn)
+  end do
+end do
+allocate(tmp(nsel,nsel))
+smat(:,:)=0.d0
+do ispn=1,nspinor
+  do jspn=1,nspinor
+    if (abs(proj(ispn,jspn)) < 1.d-14) cycle
+    call zgemm('C','N',nsel,nsel,nu,zone,b(:,:,ispn),nu,b(:,:,jspn),nu, &
+     zzero,tmp,nsel)
+    smat(:,:)=smat(:,:)+proj(ispn,jspn)*tmp(:,:)
+  end do
+end do
+smat(:,:)=(area/omega)*smat(:,:)
+deallocate(imap,igrp,b,tmp)
+end subroutine
+!EOC
