+      end do
+      write(*,*) vtlsymc(1,a),vtlsymc(2,a),vtlsymc(3,a)
+    end do
+    write(*,'("ELKPY_SESSION_END")')
+    call flush(6)
+
+  case('SYMMETRY')
+    read(line,*,iostat=ios) cmd,isymq,vpl(1),vpl(2),vpl(3),ist0,ist1
+    if (ios /= 0) then
+      write(*,'("ELKPY_SESSION_ERROR malformed SYMMETRY command")')
+      call flush(6)
+      cycle
+    end if
+    if ((ist0 < 1).or.(ist1 > nstsv).or.(ist1 < ist0)) then
+      write(*,'("ELKPY_SESSION_ERROR invalid band window (ist0,ist1,nstsv) : ", &
+       &3I8)') ist0,ist1,nstsv
+      call flush(6)
+      cycle
+    end if
+    nst=ist1-ist0+1
+    allocate(idx(nst))
+    do a=1,nst
+      idx(a)=ist0+a-1
+    end do
+    allocate(qmat(nst,nst))
+    call elkpy_symop(vpl,isymq,nst,idx,evalsv_q,qmat,ierrp)
+    if (ierrp /= 0) then
+      select case(ierrp)
+      case(1)
+        write(*,'("ELKPY_SESSION_ERROR symmetry index out of range 1..",I0)') &
+         nsymcrys
+      case(2)
+        write(*,'("ELKPY_SESSION_ERROR k-point is not invariant under this &
+         &symmetry: R.k must equal k modulo a reciprocal lattice vector")')
+      case(3)
+        write(*,'("ELKPY_SESSION_ERROR symmetry operators require nspinor=1: &
+         &a spatial rotation on a spinor also needs the SU(2) spin rotation, &
+         &which is not implemented (see docs/design.md 28)")')
+      case(4)
+        write(*,'("ELKPY_SESSION_ERROR this symmetry has a non-zero &
+         &translation (glide/screw); its n-th power is a phase times unity, &
+         &not unity, so it is refused rather than silently misread")')
+      end select
+      call flush(6)
+      deallocate(idx,qmat)
+      cycle
     end if
     write(*,*) nst,nstsv
     do a=1,nstsv
