@@ -1264,6 +1480,77 @@
       call flush(6)
       deallocate(idx,qmat)
       cycle
+    end if
+    write(*,*) nst,nstsv
+    do a=1,nstsv
+      write(*,*) evalsv_q(a)
+    end do
+    do b=1,nst
+      do a=1,nst
+        write(*,*) dble(qmat(a,b)),aimag(qmat(a,b))
+      end do
+    end do
+    write(*,'("ELKPY_SESSION_END")')
+    call flush(6)
