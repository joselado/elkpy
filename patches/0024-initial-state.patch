 end do
+! --- patch 0024: whether linengy would SEARCH these energies or not ---
+! linengy.f90 calls findband only where the species file sets apwve/lorbve
+! true; otherwise apwe/lorbe keep the apwe0/lorbe0 that init1 copied in, or
+! (with autolinengy) sit at efermi+dlefe. A loop run outside Elk freezes the
+! linearisation energies, which is EXACT in the first case and an
+! approximation in the other two -- and the difference is invisible in apwe
+! itself. Written as integers because list-directed logical output is
+! T/F, which the parser would then have to special-case.
+write(*,*) merge(1,0,autolinengy)
+do is=1,nspecies
+  do l=0,lmaxapw
+    do io=1,apword(l,is)
+      write(*,*) merge(1,0,apwve(io,l,is))
+    end do
+  end do
+end do
+do is=1,nspecies
+  do ilo=1,nlorb(is)
+    do io=1,lorbord(ilo,is)
+      write(*,*) merge(1,0,lorbve(io,ilo,is))
+    end do
+  end do
+end do
 deallocate(apwalm,evecfv,h,o,hi,oi)
 end subroutine
