 !EOC
 
 !BOP
+! !ROUTINE: elkpy_momentum
+! !INTERFACE:
+subroutine elkpy_momentum(vpl,evalsv_out,pmat)
+! !USES:
+use modmain
+! !DESCRIPTION:
+!   The momentum matrix elements
+!   $$ p^a_{nm}({\bf k})=\langle\psi_{n{\bf k}}|\left(-i\nabla
+!    +\frac{1}{4c^2}\left[\vec\sigma\times\nabla V_s({\bf r})\right]\right)_a
+!    |\psi_{m{\bf k}}\rangle $$
+!   for every pair of second-variational states at an arbitrary $k$-point,
+!   together with the eigenvalues of the SAME diagonalisation. In Hartree
+!   atomic units ($\hbar=m_e=1$) and for Elk's local Kohn-Sham potential,
+!   $\hat{\bf v}=\hat{\bf p}$ numerically, so this is equally the velocity
+!   operator; the $(1/4c^2)[\vec\sigma\times\nabla V_s]$ term is the
+!   spin-orbit correction that keeps that identity true when {\tt spinorb}
+!   is enabled (Rathgen and Katsnelson, {\it Physica Scripta} {\bf T109},
+!   170 (2004)).
+!
+!   No new momentum-operator arithmetic is done here: the matrix elements
+!   come entirely from upstream {\tt genpmatk} (unmodified -- the same
+!   subroutine Elk's own task-120 {\tt PMAT.OUT} export, {\tt putpmat.f90},
+!   calls). This routine only supplies it with the arrays it needs at an
+!   ARBITRARY $k$-point -- a fresh on-the-fly diagonalisation plus a
+!   {\tt genwfsv} expansion -- where {\tt putpmat} instead reads
+!   previously-diagonalised mesh eigenvectors from file via
+!   {\tt getevecfv}/{\tt getevecsv} and so only ever knows mesh points. That
+!   is the same {\tt elkpy\_wfcorner}-style substitution patch 0002 already
+!   makes for the Berry-curvature path task (docs/design.md \S13).
+!
+!   Two of {\tt genwfsv}'s flags differ from {\tt elkpy\_wfcorner}'s and are
+!   load-bearing rather than stylistic: {\tt tsh=.true.} (muffin-tin part in
+!   spherical HARMONICS, not spherical coordinates) because {\tt genpmatk}
+!   applies {\tt gradzfmt} to it, which expects $(\ell,m)$ coefficients;
+!   and {\tt tgp=.true.} (interstitial part as $G+p$ coefficients), because
+!   {\tt genpmatk} takes the gradient in reciprocal space itself. With
+!   {\tt tgp=.true.} the {\tt ngridg\_}/{\tt igfft\_} arguments are unused
+!   inside {\tt wfirsv}, so the coarse-grid {\tt ngdgc}/{\tt igfc} passed
+!   here (matching this file's other routines) is equivalent to
+!   {\tt putpmat}'s fine-grid {\tt ngridg}/{\tt igfft}; {\tt genpmatk}'s own
+!   interstitial FFTs are on the coarse grid either way.
+!
+!   {\tt genpmatk}'s {\tt pmat} argument is hard-dimensioned {\tt nstsv},
+!   so there is no band-window ({\tt idx}) variant to expose -- all states
+!   are always computed, and any windowing happens on the elkpy side. That
+!   suits the intended use anyway: the Kubo-style sums this feeds
+!   (docs/design.md \S22) run over states OUTSIDE the window of interest,
+!   so a windowed export would be the wrong object. The eigenvalues are
+!   returned alongside because those sums' energy denominators must come
+!   from the same diagonalisation as the matrix elements -- pairing this
+!   response with a separate {\tt EIGENSTATES} query would reintroduce
+!   exactly the degenerate-subspace basis ambiguity docs/design.md \S14
+!   warns about.
+!
+!   Hermiticity of {\tt pmat} is enforced by {\tt genpmatk} itself (it
+!   computes the upper triangle, sets the lower by conjugation and forces
+!   the diagonal real), so it is a property of upstream's construction, not
+!   evidence about this export path -- see docs/design.md \S22 for what is
+!   checked instead.
+!
+! !REVISION HISTORY:
+!   Created 2026 (elkpy)
+!EOP
+!BOC
+implicit none
+! arguments
+real(8), intent(in) :: vpl(3)
+real(8), intent(out) :: evalsv_out(nstsv)
+complex(8), intent(out) :: pmat(nstsv,nstsv,3)
+! local variables
+integer ispn,nmatp
+real(8) vl(3),vc(3)
+! automatic arrays
+integer ngp(nspnfv),igpig(ngkmax,nspnfv)
+real(8) vgpl(3,ngkmax,nspnfv),vgpc(3,ngkmax,nspnfv),gpc(ngkmax)
+real(8) evalfv(nstfv,nspnfv)
+integer, parameter :: idxall(1)=(/0/)
+! allocatable arrays
+complex(8), allocatable :: sfacgp(:,:),apwalm(:,:,:,:,:)
+complex(8), allocatable :: evecfv(:,:,:),evecsv(:,:)
+complex(8), allocatable :: wfmt(:,:,:,:),wfgp(:,:,:)
+if (spinsprl) then
+  write(*,*)
+  write(*,'("Error(elkpy_momentum): spin-spirals not supported by the elkpy &
+   &momentum matrix element task")')
+  write(*,*)
+  stop
+end if
+allocate(sfacgp(ngkmax,natmtot))
+allocate(apwalm(ngkmax,apwordmax,lmmaxapw,natmtot,nspnfv))
+allocate(evecfv(nmatmax,nstfv,nspnfv),evecsv(nstsv,nstsv))
+! fresh on-the-fly diagonalisation, same pattern as elkpy_atomproj/
+! elkpy_orbitalproj/elkpy_angmomproj (kept as its own copy rather than a
+! shared call, per this file's existing convention). Unlike those, vgpc is
+! kept per first-variational spin channel, since genpmatk indexes it that
+! way (vgpc(3,ngkmax,nspnfv)) for its interstitial gradient.
+do ispn=1,nspnfv
+  vl(1:3)=vpl(1:3)
+  vc(1:3)=bvec(1:3,1)*vpl(1)+bvec(1:3,2)*vpl(2)+bvec(1:3,3)*vpl(3)
+  call gengkvec(ngvc,ivg,vgc,vl,vc,gkmax,ngkmax,ngp(ispn),igpig(:,ispn), &
+   vgpl(:,:,ispn),vgpc(:,:,ispn),gpc)
+  call gensfacgp(ngp(ispn),vgpc(:,:,ispn),ngkmax,sfacgp)
+  call match(ngp(ispn),vgpc(:,:,ispn),gpc,sfacgp,apwalm(:,:,:,:,ispn))
+  nmatp=ngp(ispn)+nlotot
+  call eveqnfv(nmatp,ngp(ispn),igpig(:,ispn),vc,vgpc(:,:,ispn), &
+   apwalm(:,:,:,:,ispn),evalfv(:,ispn),evecfv(:,:,ispn))
+end do
+deallocate(sfacgp)
+call eveqnsv(ngp(1),igpig(:,1),vgpc(:,:,1),apwalm,evalfv,evecfv,evalsv_out, &
+ evecsv)
+! all nstsv states (idx(1)=0), in spherical harmonics (tsh) and G+p space
+! (tgp) -- both required by genpmatk, see this routine's description
+allocate(wfmt(npcmtmax,natmtot,nspinor,nstsv),wfgp(ngkmax,nspinor,nstsv))
+call genwfsv(.true.,.true.,nstsv,idxall,ngdgc,igfc,ngp,igpig,apwalm,evecfv, &
+ evecsv,wfmt,ngkmax,wfgp)
+deallocate(apwalm,evecfv,evecsv)
+! momentum matrix elements from upstream genpmatk, unmodified
+call genpmatk(ngp,igpig,vgpc,wfmt,wfgp,pmat)
+deallocate(wfmt,wfgp)
+end subroutine
+!EOC
+
+!BOP
