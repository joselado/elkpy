+! --------------------------------------------------------------------------
+! patch 0014: the muffin-tin radial integrals and the Gaunt array, i.e. every
+! remaining input of olpfv/hmlfv beyond apwalm and the interstitial blocks
+! already written above. Appended after evecfv, and behind a header of their
+! own, so a caller that only knows patch 0013's fields still parses correctly
+! up to that point.
+!
+! The interstitial ingredients (cfunig, vsig) are deliberately NOT written:
+! hi and oi above are those contributions already assembled, and vsig needs
+! the interstitial Kohn-Sham potential, which is a later phase of the port
+! than the one this serves.
+! --------------------------------------------------------------------------
+write(*,*) lmaxo,lmmaxo,nlomax,lolmmax
+do is=1,nspecies
+  write(*,*) nlorb(is)
+end do
+do is=1,nspecies
+  do ilo=1,nlorb(is)
+    write(*,*) lorbl(ilo,is)
+  end do
+end do
+! every array below is written in its own COLUMN-MAJOR order, so the caller
+! restores it with a plain order='F' reshape of the flat token stream
+do ias=1,natmtot
+  do ilo=1,nlomax
+    do lm=1,lolmmax
+      write(*,*) idxlo(lm,ilo,ias)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  do ilo=1,nlomax
+    do io=1,apwordmax
+      write(*,*) oalo(io,ilo,ias)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  do jlo=1,nlomax
+    do ilo=1,nlomax
+      write(*,*) ololo(ilo,jlo,ias)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  do l1=0,lmaxapw
+    do io=1,apwordmax
+      do l3=0,lmaxapw
+        do jo=1,apwordmax
+          do lm2=1,lmmaxo
+            write(*,*) haa(lm2,jo,l3,io,l1,ias)
+          end do
+        end do
+      end do
+    end do
+  end do
+end do
+do ias=1,natmtot
+  do ilo=1,nlomax
+    do l3=0,lmaxapw
+      do io=1,apwordmax
+        do lm2=1,lmmaxo
+          write(*,*) hloa(lm2,io,l3,ilo,ias)
+        end do
+      end do
+    end do
+  end do
+end do
+do ias=1,natmtot
+  do ilo=1,nlomax
+    do jlo=1,nlomax
+      do lm2=1,lmmaxo
+        write(*,*) hlolo(lm2,jlo,ilo,ias)
+      end do
+    end do
+  end do
+end do
+! gntyry(lm2,lm3,lm1) = <Y_{l1 m1}| R_{l2 m2} |Y_{l3 m3}> -- COMPLEX, and with
+! a REAL harmonic in the middle slot. It is k-independent and by far the
+! largest thing written here (lmmaxo*lmmaxapw^2 complex numbers); it is
+! nonetheless written per query rather than regenerated by the caller, because
+! its index convention is exactly the kind a re-derivation gets subtly wrong
+! and the whole point of this export is an element-wise comparison.
+do lm1=1,lmmaxapw
+  do lm3=1,lmmaxapw
+    do lm2=1,lmmaxo
+      write(*,*) dble(gntyry(lm2,lm3,lm1)),aimag(gntyry(lm2,lm3,lm1))
+    end do
+  end do
+end do
 deallocate(apwalm,evecfv,h,o,hi,oi)
 end subroutine
