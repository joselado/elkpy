--- a/src/elkpy_eigenstates.f90
+++ b/src/elkpy_eigenstates.f90
@@ -1724,6 +1724,28 @@
 do ig=1,ngvc
   write(*,'(4ES25.16E3)') dble(vsig(ig)),aimag(vsig(ig))
 end do
+! --- the Weinert Poisson solve's own ingredients (patch 0017) ---
+! Only what CANNOT be rebuilt from what is already here. rlmt(:,l,:) is
+! r**l and rmtl(l,:) is rmt**l, both trivial from the mesh; gclg is
+! fourpi/gc**2; and ylmg, sfacg and jlgrmt are genylmv, gensfacgp and
+! sbessel, all three of which src/elkjax/lapw.py already transcribes and
+! item 0c already checked against Elk element-wise. Exporting those would
+! be 38 MB of text to avoid reusing code that is already pinned.
+!
+! wprmt is different: splintwp's cumulative spline weights come from
+! wsplint and have no closed form worth retyping. vcln is the nuclear
+! potential from potnucl, which zpotclmt's output has ALREADY had added to
+! it by the time zpotcoul reads the sphere-boundary multipoles, so a
+! transcription that omits it gets every qlm wrong. atposc is needed for
+! the structure factors and no other query carries it.
+write(*,*) npsd,lnpsd
+do is=1,nspecies
+  write(*,'(4ES25.16E3)') wprmt(1:4,1:nrmt(is),is)
+  write(*,'(4ES25.16E3)') vcln(1:nrmt(is),is)
+end do
+do ias=1,natmtot
+  write(*,'(4ES25.16E3)') atposc(1:3,idxia(ias),idxis(ias))
+end do
 end subroutine
 !EOC
 
