--- a/src/elkpy_eigenstates.f90
+++ b/src/elkpy_eigenstates.f90
@@ -1630,6 +1630,8 @@
 implicit none
 ! local variables
 integer ik,ispn,ist,igp,i,is,ias
+integer isym,lspl,ig,jg,i1,i2,i3,j1,j2,j3
+real(8) t1
 ! allocatable arrays
 real(8), allocatable :: rhomt_(:,:),rhoir_(:),magmt_(:,:,:),magir_(:,:)
 real(8), allocatable :: rfmt(:,:),fi(:),fo(:)
@@ -1773,6 +1775,43 @@
 ! potential (gencore solves the core states in it), so exporting it is the
 ! same call as exporting vsmt: an input at fixed potential, not a step the
 ! port declines to transcribe.
+! --- symrfir as a G-space map and phase (patch 0022) ---
+! symrfir symmetrises a real interstitial function by averaging, in G-space,
+! rho(S G) e^{-i (S G).t} over the nsymcrys crystal operations -- a
+! PERMUTATION of the G-vectors plus a phase, so the whole operator is two
+! small arrays rather than the ngtc-square matrix a real-space form would be.
+! It is written out here for the same reason patch 0018 writes symrfmt's:
+! reproducing the map means transcribing symlat/lsplsymc/vtcsymc/ivgig and
+! the transpose convention of the rotation, none of which has an independent
+! check, while the map itself is what a transcription needs.
+!
+! Only ngvc G-vectors: symrfir skips ig > ngvec and leaves those components
+! zero, so the symmetrised function is truncated there too. The r2c packing
+! (nfgrz/igrzf) is an optimisation -- applying the map to every G gives the
+! same real function -- so it is deliberately not exported.
+write(*,*) nsymcrys
+do isym=1,nsymcrys
+  lspl=lsplsymc(isym)
+  do ig=1,ngvc
+    if (lspl == 1) then
+      jg=ig
+    else
+      i1=ivg(1,ig); i2=ivg(2,ig); i3=ivg(3,ig)
+      j1=symlat(1,1,lspl)*i1+symlat(2,1,lspl)*i2+symlat(3,1,lspl)*i3
+      j2=symlat(1,2,lspl)*i1+symlat(2,2,lspl)*i2+symlat(3,2,lspl)*i3
+      j3=symlat(1,3,lspl)*i1+symlat(2,3,lspl)*i2+symlat(3,3,lspl)*i3
+      jg=ivgig(j1,j2,j3)
+    end if
+    if (tv0symc(isym)) then
+      t1=0.d0
+    else
+      t1=vgc(1,jg)*vtcsymc(1,isym)+vgc(2,jg)*vtcsymc(2,isym) &
+       +vgc(3,jg)*vtcsymc(3,isym)
+    end if
+    write(*,*) jg
+    write(*,'(4ES25.16E3)') cos(t1),-sin(t1)
+  end do
+end do
 write(*,*) nspncr
 write(*,'(4ES25.16E3)') chgtot
 do ias=1,natmtot
