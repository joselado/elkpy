+! --------------------------------------------------------------------------
+! patch 0015: the muffin-tin Kohn-Sham potential, the radial mesh and its
+! quadrature weights, the linearisation energies, and the APW/local-orbital
+! radial functions in full. Everything above takes the radial integrals
+! (haa, hloa, hlolo, oalo, ololo) and the matching coefficients as GIVEN;
+! these fields are what genapwfr, genlofr, olprad and hmlrad consume to
+! build them, so with them the port can close the chain
+!
+!   vsmt -> apwfr/lofr -> radial integrals -> H, O -> evalfv
+!
+! and differentiate the spectrum with respect to the potential itself.
+!
+! Appended after gntyry, behind a header of its own, so a caller that only
+! knows patches 0013/0014 still parses correctly up to that point.
+!
+! Two conventions here are load-bearing and are exported rather than left to
+! be re-derived. vsmt is written EXACTLY as Elk packs it -- lmmaxi harmonics
+! per radial point over the inner region (points 1..nrmti), lmmaxo over the
+! outer region -- because that packing, not the values, is what a
+! transcription of hmlrad gets wrong; and wr2mt is written rather than
+! rebuilt from the mesh, because it is a Simpson-like weight array from
+! wsplint, not r^2 dr.
+! --------------------------------------------------------------------------
+write(*,*) lmaxi,lmmaxi,nrmtmax,lorbordmax,nplorb,npmtmax
+write(*,*) y00,solsc,deapw,delorb
+do is=1,nspecies
+  write(*,*) nrmti(is),npmt(is)
+end do
+do is=1,nspecies
+  do ir=1,nrmt(is)
+    write(*,*) rlmt(ir,1,is)
+  end do
+end do
+do is=1,nspecies
+  do ir=1,nrmt(is)
+    write(*,*) wr2mt(ir,is)
+  end do
+end do
+! APW derivative orders and, per atom, the linearisation energies they shift
+do is=1,nspecies
+  do l=0,lmaxapw
+    do io=1,apword(l,is)
+      write(*,*) apwdm(io,l,is)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  is=idxis(ias)
+  do l=0,lmaxapw
+    do io=1,apword(l,is)
+      write(*,*) apwe(io,l,ias)
+    end do
+  end do
+end do
+! local-orbital order, energy ordering and derivative orders
+do is=1,nspecies
+  do ilo=1,nlorb(is)
+    write(*,*) lorbord(ilo,is),idxelo(ilo,is)
+  end do
+end do
+do is=1,nspecies
+  do ilo=1,nlorb(is)
+    do jo=1,lorbord(ilo,is)
+      write(*,*) lorbdm(jo,ilo,is)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  is=idxis(ias)
+  do ilo=1,nlorb(is)
+    do jo=1,lorbord(ilo,is)
+      write(*,*) lorbe(jo,ilo,ias)
+    end do
+  end do
+end do
+! the muffin-tin Kohn-Sham potential, in Elk's own packing
+do ias=1,natmtot
+  is=idxis(ias)
+  do i=1,npmt(is)
+    write(*,*) vsmt(i,ias)
+  end do
+end do
+! the radial functions themselves: u and (the Gram-Schmidt combination of)
+! e*u for the APWs, then the surface-derivative term, then the same pair for
+! the local orbitals
+do ias=1,natmtot
+  is=idxis(ias)
+  nr=nrmt(is)
+  do l=0,lmaxapw
+    do io=1,apword(l,is)
+      do j=1,2
+        do ir=1,nr
+          write(*,*) apwfr(ir,j,io,l,ias)
+        end do
+      end do
+    end do
+  end do
+end do
+do ias=1,natmtot
+  is=idxis(ias)
+  do l=0,lmaxapw
+    do io=1,apword(l,is)
+      write(*,*) apwdfr(io,l,ias)
+    end do
+  end do
+end do
+do ias=1,natmtot
+  is=idxis(ias)
+  nr=nrmt(is)
+  do ilo=1,nlorb(is)
+    do j=1,2
+      do ir=1,nr
+        write(*,*) lofr(ir,j,ilo,ias)
+      end do
+    end do
+  end do
+end do
 deallocate(apwalm,evecfv,h,o,hi,oi)
 end subroutine
