 !EOC
 
 !BOP
+! !ROUTINE: elkpy_parity
+! !INTERFACE:
+subroutine elkpy_parity(vpl,nst,idx,evalsv_out,pmat,ierr)
+! !USES:
+use modmain
+! !DESCRIPTION:
+!   The inversion (parity) operator $\hat I$ as an {\tt nst}$\times${\tt nst}
+!   matrix $P_{mn}=\langle\psi_m|\hat I|\psi_n\rangle$ in the
+!   second-variational eigenbasis of ONE fresh on-the-fly diagonalisation at
+!   {\tt vpl}, together with that diagonalisation's eigenvalues.
+!
+!   Only meaningful where $\hat I{\bf k}\equiv{\bf k}$ modulo a reciprocal
+!   lattice vector, i.e.\ $-{\bf k}\equiv{\bf k}$, i.e.\ at one of the 8
+!   time-reversal-invariant momenta (TRIM), each fractional component being
+!   0 or $\tfrac12$. Elsewhere inversion maps the state to $-{\bf k}$, a
+!   different point, and no such matrix exists; this is detected rather than
+!   silently mis-computed (see {\tt ierr} below).
+!
+!   No new symmetry algebra is written here. The transformation of the
+!   first-variational coefficients under a crystal symmetry is lifted from
+!   upstream {\tt getevecfv.f90}, which applies exactly this operation to
+!   reconstruct wavefunctions at symmetry-related $k$-points -- code
+!   exercised by every symmetry-reduced ({\tt reducek}=1) Elk run, not a
+!   rarely-taken path. Two simplifications are legitimate here and are the
+!   only deviations: upstream's non-zero-translation branch is dropped,
+!   because {\tt findsymcrys.f90} guarantees that whenever {\tt tsyminv} is
+!   true the inversion is crystal symmetry element 2 AND has zero
+!   translation (it sets {\tt tsyminv=.false.} otherwise, having already
+!   shifted the basis to put the inversion centre at the origin); and the
+!   mesh-indexed arrays {\tt vgkl(:,:,:,ik)}/{\tt ngk(:,ik)}/{\tt igkig} are
+!   replaced by this routine's own freshly-generated {\tt gengkvec} output,
+!   the same substitution {\tt elkpy\_wfcorner} makes. The local-orbital
+!   Bloch phase factors are KEPT -- they are $e^{-2\pi i{\bf k}\cdot\tau}$
+!   terms at the atomic positions, not the (zero) translation phase.
+!
+!   Inversion is its own inverse, so upstream's active/passive
+!   (symmetry-vs-inverse-symmetry) direction convention is immaterial here.
+!   That will NOT be true when generalising to $C_n$ rotations, where the
+!   direction must be pinned explicitly before trusting the result.
+!
+!   The overlap itself reuses {\tt genwfsv} + {\tt genolpq} -- the same pair
+!   the session's {\tt OVERLAP} query already uses (docs/design.md \S14) --
+!   evaluated at $q=0$, where $e^{i{\bf q}\cdot{\bf r}}\equiv1$ so the
+!   muffin-tin phase array is simply unity (set directly rather than via
+!   {\tt genylmv} on a null vector, which is degenerate). The rotated
+!   coefficients live in the SAME LAPW basis at {\tt vpl} -- that is exactly
+!   what $\hat I{\bf k}\equiv{\bf k}$ buys -- so no basis-overlap matrix is
+!   needed.
+!
+!   Since $[\hat I,\hat H]=0$, $\hat I$ preserves energy eigenspaces, so a
+!   band window that is gapped from the rest of the spectrum is
+!   $\hat I$-invariant and $P$ restricted to it is Hermitian with
+!   $P^2=\mathbb 1$ and eigenvalues $\pm1$. Unlike \S19's angular-momentum
+!   identities, that one is NOT spoiled by the band-window truncation --
+!   precisely because the window is invariant, not merely a slice.
+!
+!   {\tt ierr}: 0 on success; 1 if the crystal has no inversion symmetry
+!   ({\tt tsyminv} false); 2 if {\tt vpl} is not inversion-invariant (some
+!   rotated $G+k$ vector has no partner in the same basis). Returned rather
+!   than a bare {\tt stop} so a bad query reports an error and leaves the
+!   interactive session alive.
+!
+! !REVISION HISTORY:
+!   Created 2026 (elkpy)
+!EOP
+!BOC
+implicit none
+! arguments
+real(8), intent(in) :: vpl(3)
+integer, intent(in) :: nst,idx(*)
+real(8), intent(out) :: evalsv_out(nstsv)
+complex(8), intent(out) :: pmat(nst,nst)
+integer, intent(out) :: ierr
+! local variables
+integer ispn,nmatp,isym,lspl,ilspl,is,ia,ias,ja,jas,ilo,l,lm,i,j,a,b
+integer igk,igp,nmatpp
+real(8) vl(3),vc(3),si(3,3),v(3),t1
+complex(8) z1
+! automatic arrays
+integer ngp(nspnfv),igpig(ngkmax,nspnfv)
+real(8) vgpl(3,ngkmax,nspnfv),vgpc(3,ngkmax),gpc(ngkmax)
+real(8) evalfv(nstfv,nspnfv)
+logical done(ngkmax)
+! allocatable arrays
+complex(8), allocatable :: sfacgp(:,:),apwalm(:,:,:,:,:)
+complex(8), allocatable :: evecfv(:,:,:),evecfvr(:,:,:),evecsv(:,:),evecfv_(:,:)
+complex(8), allocatable :: wfmt1(:,:,:,:),wfir1(:,:,:)
+complex(8), allocatable :: wfmt2(:,:,:,:),wfgp2(:,:,:)
+complex(8), allocatable :: expqmt(:,:),oq(:,:)
+ierr=0
+if (spinsprl) then
+  write(*,*)
+  write(*,'("Error(elkpy_parity): spin-spirals not supported by the elkpy &
+   &parity task")')
+  write(*,*)
+  stop
+end if
+! the crystal must have an inversion centre at all
+if (.not.tsyminv) then
+  ierr=1
+  return
+end if
+! findsymcrys.f90 puts inversion at crystal symmetry element 2, with a zero
+! translation vector (it clears tsyminv otherwise)
+isym=2
+lspl=lsplsymc(isym)
+ilspl=isymlat(lspl)
+si(1:3,1:3)=dble(symlat(1:3,1:3,ilspl))
+allocate(sfacgp(ngkmax,natmtot))
+allocate(apwalm(ngkmax,apwordmax,lmmaxapw,natmtot,nspnfv))
+allocate(evecfv(nmatmax,nstfv,nspnfv),evecfvr(nmatmax,nstfv,nspnfv))
+allocate(evecsv(nstsv,nstsv))
+! fresh on-the-fly diagonalisation, same pattern as elkpy_wfcorner
+do ispn=1,nspnfv
+  vl(1:3)=vpl(1:3)
+  vc(1:3)=bvec(1:3,1)*vpl(1)+bvec(1:3,2)*vpl(2)+bvec(1:3,3)*vpl(3)
+  call gengkvec(ngvc,ivg,vgc,vl,vc,gkmax,ngkmax,ngp(ispn),igpig(:,ispn), &
+   vgpl(:,:,ispn),vgpc,gpc)
+  call gensfacgp(ngp(ispn),vgpc,ngkmax,sfacgp)
+  call match(ngp(ispn),vgpc,gpc,sfacgp,apwalm(:,:,:,:,ispn))
+  nmatp=ngp(ispn)+nlotot
+  call eveqnfv(nmatp,ngp(ispn),igpig(:,ispn),vc,vgpc,apwalm(:,:,:,:,ispn), &
+   evalfv(:,ispn),evecfv(:,:,ispn))
+end do
+deallocate(sfacgp)
+call eveqnsv(ngp(1),igpig(:,1),vgpc,apwalm,evalfv,evecfv,evalsv_out,evecsv)
+!--------------------------------------------------------------!
+!     apply inversion to the first-variational coefficients     !
+!--------------------------------------------------------------!
+! lifted from getevecfv.f90 (see this routine's description); the
+! translation-phase branch is omitted because tv0symc(2) is guaranteed
+allocate(evecfv_(nmatmax,nstfv))
+evecfvr(:,:,:)=zzero
+do ispn=1,nspnfv
+  evecfv_(1:ngp(ispn),1:nstfv)=evecfv(1:ngp(ispn),1:nstfv,ispn)
+! apply spatial rotation operation (passive transformation)
+  done(1:ngp(ispn))=.false.
+  i=1
+  do igk=1,ngp(ispn)
+    call r3mtv(si,vgpl(:,igk,ispn),v)
+    j=0
+    do igp=i,ngp(ispn)
+      if (done(igp)) cycle
+      if (j == 0) j=igp
+      t1=abs(v(1)-vgpl(1,igp,ispn)) &
+        +abs(v(2)-vgpl(2,igp,ispn)) &
+        +abs(v(3)-vgpl(3,igp,ispn))
+      if (t1 < epslat) then
+        evecfvr(igp,1:nstfv,ispn)=evecfv_(igk,1:nstfv)
+        done(igp)=.true.
+        if (igp == j) j=j+1
+        exit
+      end if
+    end do
+    if (j > 0) i=j
+  end do
+! every rotated G+k vector must land on another one of the SAME basis --
+! true only when -k = k modulo a reciprocal lattice vector. If not, vpl is
+! not a TRIM (or the basis sphere is inconsistent) and the result would be
+! silently wrong, so fail here instead
+  if (.not.all(done(1:ngp(ispn)))) then
+    ierr=2
+    deallocate(apwalm,evecfv,evecfvr,evecsv,evecfv_)
+    return
+  end if
+end do
+!-------------------------------------------------------!
+!     translate and rotate local-orbital coefficients    !
+!-------------------------------------------------------!
+if (nlotot > 0) then
+! inverse-rotated k-point (si = -identity for inversion)
+  call r3mtv(si,vpl,v)
+  do ispn=1,nspnfv
+    nmatpp=ngp(ispn)+nlotot
+    do i=ngp(ispn)+1,nmatpp
+      evecfv_(i,1:nstfv)=evecfv(i,1:nstfv,ispn)
+    end do
+    do is=1,nspecies
+      do ia=1,natoms(is)
+        ias=idxas(ia,is)
+        ja=ieqatom(ia,is,isym)
+        jas=idxas(ja,is)
+! Bloch phase factors at the atomic positions (NOT the translation phase,
+! which is zero here) -- kept exactly as upstream getevecfv.f90
+        t1=-twopi*dot_product(vpl(1:3),atposl(1:3,ja,is))
+        z1=cmplx(cos(t1),sin(t1),8)
+        t1=twopi*dot_product(v(1:3),atposl(1:3,ia,is))
+        z1=z1*cmplx(cos(t1),sin(t1),8)
+        do ilo=1,nlorb(is)
+          l=lorbl(ilo,is)
+          lm=l**2+1
+          i=ngp(ispn)+idxlo(lm,ilo,ias)
+          j=ngp(ispn)+idxlo(lm,ilo,jas)
+          call rotzflm(symlatc(:,:,lspl),l,l,lolmmax,nstfv,nmatmax, &
+           evecfv_(j,1),evecfvr(i,1,ispn))
+          evecfvr(i:i+2*l,1:nstfv,ispn)=z1*evecfvr(i:i+2*l,1:nstfv,ispn)
+        end do
+      end do
+    end do
+  end do
+end if
+deallocate(evecfv_)
+!------------------------------------------------------!
+!     overlap <psi_m | I psi_n> via genwfsv/genolpq     !
+!------------------------------------------------------!
+allocate(wfmt1(npcmtmax,natmtot,nspinor,nst),wfir1(ngtc,nspinor,nst))
+allocate(wfmt2(npcmtmax,natmtot,nspinor,nst),wfgp2(ngkmax,nspinor,nst))
+! bra: the original states; ket: the inversion-rotated states. The SAME
+! evecsv is used for both -- inversion acts only on the spatial part, so the
+! second-variational (spinor) mixing is untouched
+call genwfsv(.false.,.false.,nst,idx,ngdgc,igfc,ngp,igpig,apwalm,evecfv, &
+ evecsv,wfmt1,ngtc,wfir1)
+call genwfsv(.false.,.true.,nst,idx,ngdgc,igfc,ngp,igpig,apwalm,evecfvr, &
+ evecsv,wfmt2,ngkmax,wfgp2)
+deallocate(apwalm,evecfv,evecfvr,evecsv)
+! q = 0, so exp(i q.r) = 1 identically; expqmt is in spherical coordinates
+! (genolpq multiplies it pointwise into wfmt), so unity is the correct fill
+allocate(expqmt(npcmtmax,natmtot),oq(nst,nst))
+expqmt(:,:)=zone
+call genolpq(nst,expqmt,ngp,igpig,wfmt1,wfir1,wfmt2,wfgp2,oq)
+! genolpq returns oq(m,n) = <psi_m(ket set)|psi_n(bra set)>; store in the
+! <bra|ket> convention pmat(a,b) = <psi_a|I psi_b>, same conversion the
+! session's OVERLAP query already makes
+do b=1,nst
+  do a=1,nst
+    pmat(a,b)=conjg(oq(b,a))
+  end do
+end do
+deallocate(wfmt1,wfir1,wfmt2,wfgp2,expqmt,oq)
+end subroutine
+!EOC
+
+!BOP
